# PostgreSQL local do compose.yml. Em outra instalação, forneça sua própria URL.
DATABASE_URL=postgresql://icsv:icsv_local@127.0.0.1:5432/icsv
# Defina true para exigir o cookie seguro também fora de NODE_ENV=production.
# SESSION_COOKIE_SECURE=true
# Em testes HTTP locais, NODE_ENV=production com SESSION_COOKIE_SECURE=false desativa a flag.
# Para alterar a porta ou senha do Docker, configure ICSV_POSTGRES_PORT / ICSV_POSTGRES_PASSWORD
# no ambiente do Docker Compose e ajuste DATABASE_URL.
